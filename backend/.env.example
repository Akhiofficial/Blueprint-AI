# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/blueprintai?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

